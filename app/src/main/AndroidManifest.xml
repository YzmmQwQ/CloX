<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Required to query installed apps on API 30+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.APPWIDGET_HOST" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Required for DND setInterruptionFilter() and isNotificationPolicyAccessGranted -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Uninstall apps from context menu -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Haptic feedback on long press -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" tools:targetApi="s" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="com.ailife.betterhealth.READ_HEALTH_DATA" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- AOD: re-wake screen when it turns off while AOD is active -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- AOD: bring the launcher to front from the background when the screen turns off in another
         app. Android blocks background activity starts unless the caller holds this permission, so
         without "Display over other apps" granted the re-wake leaves the third-party app on top. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <application
        android:name=".CloXApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.CloX"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">

        <!-- Launcher activity -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustNothing">
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Disabled alias used to trigger the launcher chooser dialog -->
        <activity-alias
            android:name=".FakeHome"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Settings — own task so it appears in recents independently -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:launchMode="singleTask"
            android:taskAffinity="com.ailife.clox.settings"
            android:theme="@style/Theme.CloX.Settings" />

        <!-- Watch face selector -->
        <activity
            android:name=".watchface.selector.WatchfaceSelectorActivity"
            android:exported="true"
            android:label="@string/wf_selector_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CloX.WatchfaceSelector" />

        <!-- Per-watchface configuration dialog (scale / offset / max FPS) -->
        <activity
            android:name=".watchface.config.WatchfaceConfigActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CloX.Transparent" />

        <!-- Launcher alias for watch face selector -->
        <activity-alias
            android:name=".WatchfaceSelectorLauncher"
            android:targetActivity=".watchface.selector.WatchfaceSelectorActivity"
            android:label="@string/wf_selector_title"
            android:icon="@mipmap/ic_launcher_watchface"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Batch import activity -->
        <activity
            android:name=".watchface.WatchfaceBatchImportActivity"
            android:exported="false"
            android:label="@string/wf_import"
            android:theme="@style/Theme.CloX.Settings" />

        <!-- Gallery activity -->
        <activity
            android:name=".watchface.gallery.GalleryActivity"
            android:exported="false"
            android:label="@string/gallery_title"
            android:theme="@style/Theme.CloX.Settings" />

        <!-- .watch file import handler -->
        <activity
            android:name=".watchface.WatchfaceImportHandlerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloX.Settings">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Remote management — own task so it shows in recents and survives navigation -->
        <activity
            android:name=".watchface.remote.RemoteManagementActivity"
            android:exported="false"
            android:label="@string/pref_wf_remote_title"
            android:launchMode="singleTask"
            android:taskAffinity="com.ailife.clox.remote"
            android:theme="@style/Theme.CloX.Settings" />

        <!-- Watch face store — own task, shows in recents -->
        <activity
            android:name=".watchface.store.WatchfaceStoreActivity"
            android:exported="false"
            android:label="@string/pref_wf_store_title"
            android:launchMode="singleTask"
            android:taskAffinity="com.ailife.clox.store"
            android:theme="@style/Theme.CloX.NoActionBar" />

        <!-- FileProvider for sharing .watch files with other apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.watchface.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Second launcher entry: CloX Settings appears as its own icon in the app list -->
        <activity-alias
            android:name=".SettingsLauncher"
            android:targetActivity=".settings.SettingsActivity"
            android:label="CloX Settings"
            android:icon="@mipmap/ic_launcher_settings"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Secret dialer code receiver — android:host="*" catches any code; filtering done in-process -->
        <receiver
            android:name=".secret.SecretCodeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="*" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".qs.CloXAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Pre-API-28 screen-off fallback: GLOBAL_ACTION_LOCK_SCREEN doesn't exist before Android P -->
        <receiver
            android:name=".admin.CloXDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Notification listener -->
        <service
            android:name=".overlay.notifications.CloXNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Third-party external data API — receives com.ailife.clox.WRITE_DATA broadcasts -->
        <receiver
            android:name=".cocos.bridge.ExternalDataReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ailife.clox.WRITE_DATA" />
            </intent-filter>
        </receiver>

        <!-- Watchface change API — receives com.android.watchengine.changeface broadcasts -->
        <receiver
            android:name=".watchface.ChangeFaceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.watchengine.changeface" />
            </intent-filter>
        </receiver>

        <!-- RTOS mode entry activity — launched from optional launcher icon -->
        <activity
            android:name=".rtos.RtosEntryActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CloX" />

        <!-- Launcher alias for RTOS mode entry (disabled by default, user enables in settings) -->
        <activity-alias
            android:name=".rtos.RtosEntryLauncher"
            android:targetActivity=".rtos.RtosEntryActivity"
            android:label="RTOS Mode"
            android:icon="@mipmap/ic_launcher_rtos"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- RTOS Mode: fake settings activity -->
        <activity
            android:name=".rtos.fakesettings.FakeSettingsActivity"
            android:exported="false"
            android:label="Settings"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CloX"
            android:excludeFromRecents="true" />

        <!-- Disabled launcher alias — enabled only when rtos_launcher_icon is on -->
        <activity-alias
            android:name=".rtos.fakesettings.FakeSettingsLauncher"
            android:targetActivity=".rtos.fakesettings.FakeSettingsActivity"
            android:label="Settings"
            android:icon="@mipmap/ic_launcher_settings"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- RTOS password setup -->
        <activity
            android:name=".rtos.settings.RtosPasswordSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CloX" />

        <!-- RTOS whitelist editor -->
        <activity
            android:name=".rtos.settings.RtosWhitelistActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CloX" />

        <!-- Crash report viewer — separate process so it survives main process death -->
        <!-- Receives pinned-shortcut requests from other apps (Android 8+) -->
        <activity
            android:name=".overlay.widgets.picker.PinShortcutConfirmActivity"
            android:theme="@style/Theme.CloX.Transparent"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".crash.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:label="Crash Report"
            android:theme="@style/Theme.CloX.Settings"
            android:excludeFromRecents="true" />

    </application>

</manifest>
