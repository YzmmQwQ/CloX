<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Dark-mode brand-blue accent (Monet fallback) ──────────────────
         Mirrors Base.Theme.CloX in values/themes.xml. In dark mode the
         lighter 300 tone reads as the accent, with dark "on" colors.
         DynamicColors still overlays the wallpaper palette when available. -->
    <style name="Base.Theme.CloX" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_300</item>
        <item name="colorOnPrimary">@color/brand_on_accent_dark</item>
        <item name="colorPrimaryContainer">@color/brand_500</item>
        <item name="colorOnPrimaryContainer">@color/brand_container_light</item>
        <item name="colorPrimaryInverse">@color/brand_500</item>
        <item name="colorSecondary">@color/brand_300</item>
        <item name="colorOnSecondary">@color/brand_on_accent_dark</item>
        <item name="colorSecondaryContainer">@color/brand_500</item>
        <item name="colorOnSecondaryContainer">@color/brand_container_light</item>
        <item name="colorTertiary">@color/brand_300</item>
        <item name="colorOnTertiary">@color/brand_on_accent_dark</item>
        <item name="colorTertiaryContainer">@color/brand_500</item>
        <item name="colorOnTertiaryContainer">@color/brand_container_light</item>
        <!-- Neutral surfaces (kills the default purple-tinted neutral palette) -->
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorSurfaceBright">@color/m3_surface_bright</item>
        <item name="colorSurfaceDim">@color/m3_surface_dim</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
    </style>

    <!-- ── Monet backport overlay (dark) — see values/themes.xml ── -->
    <style name="ThemeOverlay.App.Monet" parent="" tools:targetApi="s">
        <item name="colorPrimary">@android:color/system_accent1_200</item>
        <item name="colorOnPrimary">@android:color/system_accent1_800</item>
        <item name="colorPrimaryContainer">@android:color/system_accent1_700</item>
        <item name="colorOnPrimaryContainer">@android:color/system_accent1_100</item>
        <item name="colorPrimaryInverse">@android:color/system_accent1_600</item>

        <item name="colorSecondary">@android:color/system_accent2_200</item>
        <item name="colorOnSecondary">@android:color/system_accent2_800</item>
        <item name="colorSecondaryContainer">@android:color/system_accent2_700</item>
        <item name="colorOnSecondaryContainer">@android:color/system_accent2_100</item>

        <item name="colorTertiary">@android:color/system_accent3_200</item>
        <item name="colorOnTertiary">@android:color/system_accent3_800</item>
        <item name="colorTertiaryContainer">@android:color/system_accent3_700</item>
        <item name="colorOnTertiaryContainer">@android:color/system_accent3_100</item>

        <item name="android:colorBackground">@android:color/system_neutral1_900</item>
        <item name="colorOnBackground">@android:color/system_neutral1_100</item>
        <item name="colorSurface">@android:color/system_neutral1_900</item>
        <item name="colorOnSurface">@android:color/system_neutral1_100</item>
        <item name="colorSurfaceVariant">@android:color/system_neutral2_700</item>
        <item name="colorOnSurfaceVariant">@android:color/system_neutral2_200</item>
        <item name="colorSurfaceInverse">@android:color/system_neutral1_100</item>
        <item name="colorOnSurfaceInverse">@android:color/system_neutral1_800</item>

        <item name="colorSurfaceBright">@android:color/system_neutral2_200</item>
        <item name="colorSurfaceDim">@android:color/system_neutral1_900</item>
        <item name="colorSurfaceContainerLowest">@android:color/system_neutral1_900</item>
        <item name="colorSurfaceContainerLow">@android:color/system_neutral1_900</item>
        <item name="colorSurfaceContainer">@android:color/system_neutral1_800</item>
        <item name="colorSurfaceContainerHigh">@android:color/system_neutral1_800</item>
        <item name="colorSurfaceContainerHighest">@android:color/system_neutral2_700</item>

        <item name="colorOutline">@android:color/system_neutral2_400</item>
        <item name="colorOutlineVariant">@android:color/system_neutral2_700</item>
    </style>

</resources>
