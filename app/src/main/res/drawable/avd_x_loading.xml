<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher X as a loading animation: four round-cap sticks radiating
     from the center (blue "<" pair left, white ">" pair right), lengths
     pulsing via trimPathEnd. The four pulses are identical but phase-shifted
     by a quarter cycle each, ordered clockwise around the ring
     (NE → SE → SW → NW), so the pulse travels around the circle as a wave
     rather than mirroring symmetrically across the diagonals.

     Full reverse cycle = 2 x 400 = 800 ms; each stick is offset by 800/4 =
     200 ms so the four are evenly spread around the wave at all times.

     An AVD (not a View-level ValueAnimator) on purpose: AnimatedVectorDrawable
     runs on the RenderThread, so the animation keeps playing even when the
     main thread janks while the watchface loads on the GL thread. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="88dp"
            android:height="88dp"
            android:viewportWidth="100"
            android:viewportHeight="100">
            <!-- Sticks run from inner radius 9 to outer radius 36 (of 50);
                 trimPathEnd 0.45 ≈ the old minimum length (outer radius 21).
                 All start at full length; the phase comes from startOffset. -->
            <path
                android:name="stickNE"
                android:pathData="M 56.36,43.64 L 75.46,24.54"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="7"
                android:strokeLineCap="round"
                android:trimPathEnd="1" />
            <path
                android:name="stickSE"
                android:pathData="M 56.36,56.36 L 75.46,75.46"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="7"
                android:strokeLineCap="round"
                android:trimPathEnd="1" />
            <path
                android:name="stickSW"
                android:pathData="M 43.64,56.36 L 24.54,75.46"
                android:strokeColor="#82ABD1"
                android:strokeWidth="7"
                android:strokeLineCap="round"
                android:trimPathEnd="1" />
            <path
                android:name="stickNW"
                android:pathData="M 43.64,43.64 L 24.54,24.54"
                android:strokeColor="#82ABD1"
                android:strokeWidth="7"
                android:strokeLineCap="round"
                android:trimPathEnd="1" />
        </vector>
    </aapt:attr>

    <!-- Clockwise wave: NE leads, each next corner lags by a quarter cycle. -->
    <target android:name="stickNE">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="1"
                android:valueTo="0.45"
                android:valueType="floatType"
                android:duration="400"
                android:startOffset="0"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="stickSE">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="1"
                android:valueTo="0.45"
                android:valueType="floatType"
                android:duration="400"
                android:startOffset="200"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="stickSW">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="1"
                android:valueTo="0.45"
                android:valueType="floatType"
                android:duration="400"
                android:startOffset="400"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="stickNW">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="1"
                android:valueTo="0.45"
                android:valueType="floatType"
                android:duration="400"
                android:startOffset="600"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
