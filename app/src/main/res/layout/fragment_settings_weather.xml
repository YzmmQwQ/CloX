<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Master enable -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp" android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeWidth="1dp" app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/pref_weather_enabled_title"
                        android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/pref_weather_enabled_summary"
                        android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWeatherEnabled"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Source -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp" android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeWidth="1dp" app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/pref_weather_category_source"
                    android:textSize="13sp" android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" android:layout_marginBottom="10dp" />

                <!-- Provider picker -->
                <LinearLayout android:id="@+id/rowWeatherProvider"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_provider_title"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/tvWeatherProvider"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_expand_more" app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Auto language -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_language_title"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_language_summary"
                            android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchWeatherLanguage"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- WeatherAPI key (hidden by default) -->
                <LinearLayout android:id="@+id/rowWeatherApiKey"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="14dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_weatherapi_key_title"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/tvWeatherApiKey"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_weatherapi_key_summary"
                            android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_edit" app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- OWM key (hidden by default) -->
                <LinearLayout android:id="@+id/rowOwmKey"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="14dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_owm_key_title"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/tvOwmKey"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_owm_key_summary"
                            android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_edit" app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Display -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp" android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeWidth="1dp" app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/pref_weather_category_display"
                    android:textSize="13sp" android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" android:layout_marginBottom="10dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_round_title"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_round_summary"
                            android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchWeatherRound"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Update -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp" android:layout_marginBottom="10dp"
            app:cardCornerRadius="16dp" app:cardElevation="0dp"
            app:strokeWidth="1dp" app:strokeColor="?attr/colorOutline"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/pref_weather_category_update"
                    android:textSize="13sp" android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" android:layout_marginBottom="10dp" />

                <LinearLayout android:id="@+id/rowWeatherInterval"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_interval_title"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/tvWeatherInterval"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_expand_more" app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!-- Refresh button row -->
                <LinearLayout android:id="@+id/rowWeatherRefresh"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="14dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tvRefreshTitle"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_refresh_title"
                            android:textSize="14sp" android:textColor="?attr/colorOnSurface" />
                        <TextView android:id="@+id/tvRefreshSummary"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/pref_weather_refresh_summary"
                            android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_loop" app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
