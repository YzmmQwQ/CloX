<?xml version="1.0" encoding="utf-8"?>
<!-- No background/scrim here — OverlayController applies blur + scrim via overlayScrim -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- No background here — blurLayer + overlayScrim in activity_main.xml provide
         the blur and darkening effect. QS overlay itself is fully transparent. -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <!-- STATUS BAR
                 Battery centered, time to its left, date to its right —
                 mirrors old app layout so items cluster around center, not corners -->
            <!-- STATUS BAR: battery group anchored to center; time/date relative to it
                 so all three cluster around the middle, not pinned to screen edges -->
            <RelativeLayout
                android:id="@+id/qsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_marginBottom="6dp">

                <!-- Battery group (icon + %) — the center anchor -->
                <LinearLayout
                    android:id="@+id/qsBatteryGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/qsBatteryIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/baseline_battery_full_24"
                        android:tint="@color/on_dark_primary"/>

                    <TextView
                        android:id="@+id/qsBatteryPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textSize="22sp"
                        android:textColor="@color/on_dark_primary"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:text="--%"/>

                </LinearLayout>

                <!-- Time: just to the left of the battery group -->
                <TextView
                    android:id="@+id/qsTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/qsBatteryGroup"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="20dp"
                    android:textSize="22sp"
                    android:textColor="@color/on_dark_primary"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:text="00:00"/>

                <!-- Date: just to the right of the battery group -->
                <TextView
                    android:id="@+id/qsDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/qsBatteryGroup"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:textSize="22sp"
                    android:textColor="@color/on_dark_secondary"
                    android:maxLines="1"/>

            </RelativeLayout>

            <!-- BRIGHTNESS SLIDER — icons overlaid inside the bar at each end -->
            <FrameLayout
                android:id="@+id/qsBrightnessRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <com.ailife.clox.overlay.quicksettings.BrightnessSlider
                    android:id="@+id/brightnessSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="-17dp"
                    android:layout_marginEnd="-17dp"
                    android:valueFrom="0"
                    android:valueTo="255"
                    app:thumbRadius="17dp"
                    app:haloRadius="17dp"
                    app:trackHeight="30dp"
                    app:trackInsideCornerSize="1dp"/>

                <!-- End icons sit ON the slider tracks, which are always theme-colored:
                     left over the active track (colorPrimary), right over the inactive
                     track — hardcoded white disappears on light-theme tracks. -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="20dp"
                    android:src="@drawable/baseline_brightness_low_24"
                    app:tint="?attr/colorOnPrimary"/>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="20dp"
                    android:src="@drawable/baseline_brightness_high_24"
                    app:tint="?attr/colorOnSurfaceVariant"/>

            </FrameLayout>

            <!-- PAGED TILE GRID -->
            <!-- Height is a placeholder; buildTileGrid() sets it at runtime from displayMetrics -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/qsTilePager"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>

            <!-- PAGE INDICATOR DOTS — hidden when only 1 page -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/qsPageIndicator"
                android:layout_width="wrap_content"
                android:layout_height="10dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:background="@drawable/qs_page_indicator_bg"
                app:tabBackground="@drawable/qs_page_dot_selector"
                app:tabGravity="center"
                app:tabIndicatorHeight="0dp"
                app:tabIndicatorColor="@android:color/transparent"
                app:tabPaddingStart="8dp"
                app:tabPaddingEnd="8dp"/>

            <!-- DIVIDER -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:background="@color/on_dark_scrim"/>

            <!-- BOTTOM ACTION BAR — 5 buttons centered with Space weights,
                 matching old app: LauncherSettings | Recents | Flashlight | Power | Settings -->
            <LinearLayout
                android:id="@+id/qsBottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <ImageButton
                    android:id="@+id/qsBtnLauncherSettings"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/qs_btn_bg"
                    android:src="@drawable/baseline_tune_24"
                    android:tint="@color/on_dark_primary"
                    android:padding="12dp"
                    android:contentDescription="@string/cd_launcher_settings"/>

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <ImageButton
                    android:id="@+id/qsBtnRecents"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/qs_btn_bg"
                    android:src="@drawable/ic_recents"
                    android:tint="@color/on_dark_primary"
                    android:padding="12dp"
                    android:contentDescription="@string/cd_recents"/>

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <ImageButton
                    android:id="@+id/qsBtnFlashlight"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/qs_btn_bg"
                    android:src="@drawable/baseline_flashlight_on_24"
                    android:tint="@color/on_dark_primary"
                    android:padding="12dp"
                    android:contentDescription="@string/cd_flashlight"/>

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <ImageButton
                    android:id="@+id/qsBtnPower"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/qs_btn_bg"
                    android:src="@drawable/baseline_power_settings_new_24"
                    android:tint="@color/on_dark_primary"
                    android:padding="12dp"
                    android:contentDescription="@string/cd_power"/>

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

                <ImageButton
                    android:id="@+id/qsBtnSettings"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/qs_btn_bg"
                    android:src="@drawable/baseline_settings_24"
                    android:tint="@color/on_dark_primary"
                    android:padding="12dp"
                    android:contentDescription="@string/cd_settings"/>

                <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
