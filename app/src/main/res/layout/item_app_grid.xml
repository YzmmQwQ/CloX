<?xml version="1.0" encoding="utf-8"?>
<!-- SquareFrameLayout forces height = width in onMeasure.
     Icon fills the square; label overlays at the bottom when enabled. -->
<com.ailife.clox.applist.SquareFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/selectableItemBackgroundBorderless">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/notifBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="3dp"
        android:gravity="center"
        android:minWidth="10dp"
        android:minHeight="10dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/app_label_scrim"
        android:textColor="@color/on_dark_primary"
        android:textSize="9sp"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />

</com.ailife.clox.applist.SquareFrameLayout>
