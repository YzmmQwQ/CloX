<?xml version="1.0" encoding="utf-8"?>
<com.yzmm.clox.gesture.GestureInterceptorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gestureRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HomeFragment / Axmol surface lives here (bottom layer) -->
    <FrameLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Blur nesting for the app-list scene (BlurView 3.x BlurTarget model):
         · blurTargetLaunch  — captured by the app-OPEN launch blur (app list + folder card).
         · blurTargetFolder  — captured by the folder backdrop blur (app list only).
         The folder card and folder backdrop BlurView are added at runtime as children of
         blurTargetLaunch (outside blurTargetFolder), so the launch blur blurs the card while the
         folder backdrop blur does not. Each BlurView sits OUTSIDE the target it captures. -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/blurTargetLaunch"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <eightbitlab.com.blurview.BlurTarget
            android:id="@+id/blurTargetFolder"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- AppListFragment slides in/out over this container -->
            <FrameLayout
                android:id="@+id/fragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </eightbitlab.com.blurview.BlurTarget>

    </eightbitlab.com.blurview.BlurTarget>

    <!-- Static blur layer — sits above watchface, never animates.
         Populated by BlurEngine when an overlay opens; cleared when it closes. -->
    <ImageView
        android:id="@+id/blurLayer"
        android:tag="blur_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Scrim — darkens watchface as an overlay drags in -->
    <View
        android:id="@+id/overlayScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/clox_bg"
        android:alpha="0"
        android:visibility="gone" />

    <!-- Overlays — GONE by default, above all fragments -->
    <com.yzmm.clox.overlay.quicksettings.QuickSettingsOverlay
        android:id="@+id/quickSettingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.yzmm.clox.overlay.widgets.WidgetsOverlay
        android:id="@+id/widgetsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.yzmm.clox.overlay.notifications.NotificationOverlay
        android:id="@+id/notificationsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- FlashlightOverlay: topmost child, white fill, hidden until triggered -->
    <com.yzmm.clox.overlay.quicksettings.FlashlightOverlay
        android:id="@+id/flashlightOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:visibility="gone" />

    <!-- Gesture lock indicator: shown at top-center when gestures are locked -->
    <ImageView
        android:id="@+id/gestureLockIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_lock_gesture"
        android:tint="@color/on_dark_medium"
        android:visibility="gone"
        android:alpha="0.85"
        android:importantForAccessibility="no" />

    <!-- App-open splash: the animated app-icon X (same wave as the watchface
         loader) with the CloX wordmark below. Faded out after launch. -->
    <FrameLayout
        android:id="@+id/appSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/clox_bg"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp">

                <com.yzmm.clox.watchface.loading.SquircleIconView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- AVD: reuses the watchface loader's circular-wave X -->
                <ImageView
                    android:id="@+id/appSplashSticks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/avd_x_loading"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/appSplashText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/on_dark_primary"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </FrameLayout>

</com.yzmm.clox.gesture.GestureInterceptorLayout>
