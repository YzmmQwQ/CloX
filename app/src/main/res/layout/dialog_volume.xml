<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/dialog_volume_title"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <!-- Media -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <ImageView android:id="@+id/volMediaIcon" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_volume" android:layout_marginEnd="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/volMediaSlider"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:valueFrom="0" android:valueTo="1" app:thumbRadius="8dp" app:trackHeight="4dp" />
        <TextView android:id="@+id/volMediaPct" android:layout_width="36dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="end"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
    </LinearLayout>

    <!-- Ring -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <ImageView android:id="@+id/volRingIcon" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_dnd" android:layout_marginEnd="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/volRingSlider"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:valueFrom="0" android:valueTo="1" app:thumbRadius="8dp" app:trackHeight="4dp" />
        <TextView android:id="@+id/volRingPct" android:layout_width="36dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="end"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
    </LinearLayout>

    <!-- Alarm -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <ImageView android:id="@+id/volAlarmIcon" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_aod" android:layout_marginEnd="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/volAlarmSlider"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:valueFrom="0" android:valueTo="1" app:thumbRadius="8dp" app:trackHeight="4dp" />
        <TextView android:id="@+id/volAlarmPct" android:layout_width="36dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="end"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
    </LinearLayout>

    <!-- Notification -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/volNotifIcon" android:layout_width="24dp" android:layout_height="24dp"
            android:src="@drawable/ic_dnd" android:layout_marginEnd="12dp" />
        <com.google.android.material.slider.Slider android:id="@+id/volNotifSlider"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:valueFrom="0" android:valueTo="1" app:thumbRadius="8dp" app:trackHeight="4dp" />
        <TextView android:id="@+id/volNotifPct" android:layout_width="36dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="end"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
    </LinearLayout>

</LinearLayout>
