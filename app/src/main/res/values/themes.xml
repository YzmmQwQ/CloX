<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CloX" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.CloX.Settings" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <style name="Theme.CloX.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <style name="Theme.CloX.WatchfaceSelector" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Album art: 12dp rounded corners -->
    <style name="ShapeAppearance.AlbumArt" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Play/pause button: rounded square -->
    <style name="ShapeAppearance.PlayPause" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>
