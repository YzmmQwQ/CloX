<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Base theme: Monet-fallback brand-blue accent ──────────────────
         Non-dynamic devices get the brand blue instead of Material 3's
         default purple. On Monet-capable devices, DynamicColors overlays
         the wallpaper palette on top of these values. Light-mode tones;
         values-night/themes.xml supplies the dark-mode counterparts. -->
    <style name="Base.Theme.CloX" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/brand_on_accent_light</item>
        <item name="colorPrimaryContainer">@color/brand_container_light</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container_light</item>
        <item name="colorPrimaryInverse">@color/brand_300</item>
        <item name="colorSecondary">@color/brand_500</item>
        <item name="colorOnSecondary">@color/brand_on_accent_light</item>
        <item name="colorSecondaryContainer">@color/brand_container_light</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_container_light</item>
        <item name="colorTertiary">@color/brand_500</item>
        <item name="colorOnTertiary">@color/brand_on_accent_light</item>
        <item name="colorTertiaryContainer">@color/brand_container_light</item>
        <item name="colorOnTertiaryContainer">@color/brand_on_container_light</item>
        <!-- Neutral surfaces (kills the default purple-tinted neutral palette) -->
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorSurfaceBright">@color/m3_surface_bright</item>
        <item name="colorSurfaceDim">@color/m3_surface_dim</item>
        <item name="colorSurfaceInverse">@color/m3_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/m3_inverse_on_surface</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
    </style>

    <!-- ── Monet backport overlay (light) ────────────────────────────────
         Maps Material 3 color roles onto the system_accent*/system_neutral*
         palettes for pre-S ROMs that backport them (Android 11 monet
         backport). Applied at runtime by MonetBackport only after probing
         that the framework resources actually resolve; on S+ Material's
         DynamicColors takes over instead. Error roles stay on the base
         Theme.Material3 red by design. -->
    <style name="ThemeOverlay.App.Monet" parent="" tools:targetApi="s">
        <!-- Primary -->
        <item name="colorPrimary">@android:color/system_accent1_600</item>
        <item name="colorOnPrimary">@android:color/system_accent1_0</item>
        <item name="colorPrimaryContainer">@android:color/system_accent1_100</item>
        <item name="colorOnPrimaryContainer">@android:color/system_accent1_900</item>
        <item name="colorPrimaryInverse">@android:color/system_accent1_200</item>
        <!-- Secondary -->
        <item name="colorSecondary">@android:color/system_accent2_600</item>
        <item name="colorOnSecondary">@android:color/system_accent2_0</item>
        <item name="colorSecondaryContainer">@android:color/system_accent2_100</item>
        <item name="colorOnSecondaryContainer">@android:color/system_accent2_900</item>
        <!-- Tertiary -->
        <item name="colorTertiary">@android:color/system_accent3_600</item>
        <item name="colorOnTertiary">@android:color/system_accent3_0</item>
        <item name="colorTertiaryContainer">@android:color/system_accent3_100</item>
        <item name="colorOnTertiaryContainer">@android:color/system_accent3_900</item>
        <!-- Background / Surface -->
        <item name="android:colorBackground">@android:color/system_neutral1_10</item>
        <item name="colorOnBackground">@android:color/system_neutral1_900</item>
        <item name="colorSurface">@android:color/system_neutral1_10</item>
        <item name="colorOnSurface">@android:color/system_neutral1_900</item>
        <item name="colorSurfaceVariant">@android:color/system_neutral2_100</item>
        <item name="colorOnSurfaceVariant">@android:color/system_neutral2_700</item>
        <item name="colorSurfaceInverse">@android:color/system_neutral1_800</item>
        <item name="colorOnSurfaceInverse">@android:color/system_neutral1_50</item>
        <!-- Surface containers (Material 1.10+) -->
        <item name="colorSurfaceBright">@android:color/system_neutral1_10</item>
        <item name="colorSurfaceDim">@android:color/system_neutral2_100</item>
        <item name="colorSurfaceContainerLowest">@android:color/system_neutral1_0</item>
        <item name="colorSurfaceContainerLow">@android:color/system_neutral1_10</item>
        <item name="colorSurfaceContainer">@android:color/system_neutral2_50</item>
        <item name="colorSurfaceContainerHigh">@android:color/system_neutral2_100</item>
        <item name="colorSurfaceContainerHighest">@android:color/system_neutral2_100</item>
        <!-- Outline -->
        <item name="colorOutline">@android:color/system_neutral2_500</item>
        <item name="colorOutlineVariant">@android:color/system_neutral2_200</item>
    </style>

    <!-- ── Cold-start splash — branded X on black so the launch window is
         never blank black while MainActivity inflates + Axmol GL warms up.
         Hands off to Theme.CloX once the first frame is ready. ── -->
    <style name="Theme.CloX.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_x_splash</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.CloX</item>
    </style>

    <!-- ── Launcher / watchface screen — black, no system bars ── -->
    <!-- windowShowWallpaper: routes the app↔home transition through the framework WALLPAPER_* anim
         set (distinct from the app↔app task_* set). The CloXTransitions RRO zeroes those wallpaper
         anims, so ONLY the home-return transition becomes an instant cut (no default slide) while
         ordinary app↔app transitions keep their normal animation. The GL SurfaceView's transparent
         region is what makes the wallpaper actually participate behind the watchface. -->
    <style name="Theme.CloX" parent="Base.Theme.CloX">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

    <!-- For activities that finish immediately without showing any UI -->
    <style name="Theme.CloX.Transparent" parent="Base.Theme.CloX">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- ── Settings and standard UI screens — NoActionBar, toolbar in layout ── -->
    <style name="Theme.CloX.Settings" parent="Base.Theme.CloX">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- Alias used by WatchfaceStore, Gallery, Remote, etc. -->
    <style name="Theme.CloX.NoActionBar" parent="Base.Theme.CloX">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- ── Watchface selector — full black, edge-to-edge, hides bars ── -->
    <style name="Theme.CloX.WatchfaceSelector" parent="Base.Theme.CloX">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- ── Shape tokens ── -->
    <style name="ShapeAppearance.AlbumArt" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.PlayPause" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>
