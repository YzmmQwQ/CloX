<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ── Style picker ──────────────────────────────────────────────────────── -->
    <ListPreference
        android:key="style"
        android:title="@string/pref_app_list_style_title"
        android:summary="%s"
        android:entries="@array/app_list_style_entries"
        android:entryValues="@array/app_list_style_values"
        android:defaultValue="list" />

    <!-- ── List sub-settings ─────────────────────────────────────────────────── -->
    <PreferenceCategory
        android:key="cat_list"
        android:title="@string/applist_setting_list_options_category">

        <SwitchPreferenceCompat
            android:key="list_search"
            android:title="@string/pref_list_search_title"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="list_3d"
            android:title="@string/pref_list_3d_title"
            android:summary="@string/pref_list_3d_summary"
            android:defaultValue="false" />

        <SeekBarPreference
            android:key="list_3d_min_scale"
            android:title="@string/pref_3d_min_scale_title"
            android:summary="@string/pref_3d_min_scale_summary"
            android:defaultValue="50"
            android:min="20"
            android:max="100"
            android:dependency="list_3d"
            app:showSeekBarValue="true" />

        <ListPreference
            android:key="list_3d_curve"
            android:title="@string/pref_3d_curve_title"
            android:summary="%s"
            android:entries="@array/curve_entries"
            android:entryValues="@array/curve_values"
            android:defaultValue="linear"
            android:dependency="list_3d" />

    </PreferenceCategory>

    <!-- ── Grid sub-settings ─────────────────────────────────────────────────── -->
    <PreferenceCategory
        android:key="cat_grid"
        android:title="@string/applist_setting_grid_options_category">

        <SeekBarPreference
            android:key="grid_cols"
            android:title="@string/pref_grid_cols_title"
            android:defaultValue="4"
            android:min="2"
            android:max="6"
            app:showSeekBarValue="true" />

        <SwitchPreferenceCompat
            android:key="grid_names"
            android:title="@string/pref_grid_names_title"
            android:defaultValue="true" />

    </PreferenceCategory>

    <!-- ── Waterfall sub-settings ─────────────────────────────────────────────── -->
    <PreferenceCategory
        android:key="cat_waterfall"
        android:title="@string/applist_setting_waterfall_options_category">

        <SwitchPreferenceCompat
            android:key="waterfall_3d"
            android:title="@string/pref_waterfall_3d_title"
            android:summary="@string/pref_waterfall_3d_summary"
            android:defaultValue="false" />

        <SeekBarPreference
            android:key="waterfall_3d_min_scale"
            android:title="@string/pref_3d_min_scale_title"
            android:summary="@string/pref_3d_min_scale_summary"
            android:defaultValue="50"
            android:min="20"
            android:max="100"
            android:dependency="waterfall_3d"
            app:showSeekBarValue="true" />

        <ListPreference
            android:key="waterfall_3d_curve"
            android:title="@string/pref_3d_curve_title"
            android:summary="%s"
            android:entries="@array/curve_entries"
            android:entryValues="@array/curve_values"
            android:defaultValue="linear"
            android:dependency="waterfall_3d" />

    </PreferenceCategory>

    <!-- ── Honeycomb sub-settings ─────────────────────────────────────────────── -->
    <PreferenceCategory
        android:key="cat_honeycomb"
        android:title="@string/applist_setting_honeycomb_options_category">

        <SwitchPreferenceCompat
            android:key="honeycomb_3d"
            android:title="@string/pref_honeycomb_3d_title"
            android:summary="@string/pref_honeycomb_3d_summary"
            android:defaultValue="false" />

        <SeekBarPreference
            android:key="honeycomb_3d_min_scale"
            android:title="@string/pref_3d_min_scale_title"
            android:summary="@string/pref_3d_min_scale_summary"
            android:defaultValue="50"
            android:min="20"
            android:max="100"
            android:dependency="honeycomb_3d"
            app:showSeekBarValue="true" />

        <ListPreference
            android:key="honeycomb_3d_curve"
            android:title="@string/pref_3d_curve_title"
            android:summary="%s"
            android:entries="@array/curve_entries"
            android:entryValues="@array/curve_values"
            android:defaultValue="linear"
            android:dependency="honeycomb_3d" />

        <SeekBarPreference
            android:key="honeycomb_icon_size"
            android:title="@string/pref_honeycomb_icon_size_title"
            android:defaultValue="0"
            android:min="0"
            android:max="120"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

    <!-- ── Grid 2D sub-settings ───────────────────────────────────────────────── -->
    <PreferenceCategory
        android:key="cat_grid2d"
        android:title="@string/applist_setting_grid2d_options_category">

        <SwitchPreferenceCompat
            android:key="grid2d_names"
            android:title="@string/pref_grid2d_names_title"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="grid2d_3d"
            android:title="@string/pref_grid2d_3d_title"
            android:defaultValue="false" />

        <SeekBarPreference
            android:key="grid2d_3d_min_scale"
            android:title="@string/pref_3d_min_scale_title"
            android:summary="@string/pref_3d_min_scale_summary"
            android:defaultValue="50"
            android:min="20"
            android:max="100"
            android:dependency="grid2d_3d"
            app:showSeekBarValue="true" />

        <ListPreference
            android:key="grid2d_3d_curve"
            android:title="@string/pref_3d_curve_title"
            android:summary="%s"
            android:entries="@array/curve_entries"
            android:entryValues="@array/curve_values"
            android:defaultValue="linear"
            android:dependency="grid2d_3d" />

        <SeekBarPreference
            android:key="grid2d_icon_size"
            android:title="@string/pref_grid2d_icon_size_title"
            android:defaultValue="0"
            android:min="0"
            android:max="120"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

    <!-- ── Pages sub-settings ─────────────────────────────────────────────────── -->
    <PreferenceCategory
        android:key="cat_pages"
        android:title="@string/applist_setting_pages_options_category">

        <SeekBarPreference
            android:key="pages_cols"
            android:title="@string/pref_pages_cols_title"
            android:defaultValue="4"
            android:min="2"
            android:max="6"
            app:showSeekBarValue="true" />

        <SeekBarPreference
            android:key="pages_rows"
            android:title="@string/pref_pages_rows_title"
            android:defaultValue="5"
            android:min="2"
            android:max="8"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

    <!-- ── Notification badges ───────────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/pref_notif_badge_category">

        <SwitchPreferenceCompat
            android:key="notif_badge"
            android:title="@string/pref_notif_badge_title"
            android:summary="@string/pref_notif_badge_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="notif_badge_count"
            android:title="@string/pref_notif_badge_count_title"
            android:summary="@string/pref_notif_badge_count_summary"
            android:defaultValue="true"
            android:dependency="notif_badge" />

    </PreferenceCategory>

    <!-- ── Generic / global settings ─────────────────────────────────────────── -->
    <PreferenceCategory android:title="@string/applist_setting_general_category">

        <ListPreference
            android:key="sort"
            android:title="@string/pref_app_list_sort_title"
            android:summary="%s"
            android:entries="@array/app_list_sort_entries"
            android:entryValues="@array/app_list_sort_values"
            android:defaultValue="alpha" />

        <Preference
            android:key="sort_custom_hint"
            android:summary="@string/pref_app_list_sort_custom_hint"
            android:selectable="false" />

        <ListPreference
            android:key="icon_pack"
            android:title="@string/pref_icon_pack_title"
            android:summary="%s"
            android:defaultValue="" />

        <Preference
            android:key="hidden_apps"
            android:title="@string/pref_hidden_apps_title"
            android:summary="@string/applist_setting_hidden_apps_summary" />

        <Preference
            android:key="bg_image_pick"
            android:title="@string/applist_setting_bg_image_title"
            android:summary="@string/applist_setting_bg_image_summary" />

        <Preference
            android:key="bg_image_clear"
            android:title="@string/applist_setting_clear_bg_btn"
            android:visible="false" />

        <SeekBarPreference
            android:key="wallpaper_dim"
            android:title="@string/applist_setting_darken_bg_title"
            android:defaultValue="0"
            android:min="0"
            android:max="90"
            android:visible="false"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

</PreferenceScreen>
