<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <ListPreference
        android:key="app_list_style"
        android:title="@string/pref_app_list_style_title"
        android:summary="%s"
        android:entries="@array/app_list_style_entries"
        android:entryValues="@array/app_list_style_values"
        android:defaultValue="list" />

    <Preference
        android:key="hidden_apps"
        android:title="@string/pref_hidden_apps_title"
        android:summary="Manage which apps appear in the launcher" />

</PreferenceScreen>
