<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_gestures_watchface_category">

        <ListPreference
            android:key="double_tap_action"
            android:title="@string/pref_double_tap_title"
            android:summary="%s"
            android:entries="@array/gesture_action_entries"
            android:entryValues="@array/gesture_action_values"
            android:defaultValue="screen_off" />

        <ListPreference
            android:key="long_press_action"
            android:title="@string/pref_long_press_title"
            android:summary="%s"
            android:entries="@array/gesture_action_entries"
            android:entryValues="@array/gesture_action_values"
            android:defaultValue="watchface_selector" />

        <SwitchPreferenceCompat
            android:key="home_press_screen_off"
            android:title="@string/pref_home_press_screen_off_title"
            android:summary="@string/pref_home_press_screen_off_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_btn_map_category">

        <Preference
            android:key="btn_map_record"
            android:title="@string/pref_btn_map_record_title"
            android:summary="@string/pref_btn_map_record_summary" />

        <ListPreference
            android:key="btn_single_press_action"
            android:title="@string/pref_btn_single_title"
            android:summary="%s"
            android:entries="@array/gesture_action_entries"
            android:entryValues="@array/gesture_action_values"
            android:defaultValue="nothing"
            android:enabled="false" />

        <ListPreference
            android:key="btn_double_press_action"
            android:title="@string/pref_btn_double_title"
            android:summary="%s"
            android:entries="@array/gesture_action_entries"
            android:entryValues="@array/gesture_action_values"
            android:defaultValue="nothing"
            android:enabled="false" />

        <ListPreference
            android:key="btn_long_press_action"
            android:title="@string/pref_btn_long_title"
            android:summary="%s"
            android:entries="@array/gesture_action_entries"
            android:entryValues="@array/gesture_action_values"
            android:defaultValue="nothing"
            android:enabled="false" />

        <Preference
            android:key="btn_map_clear"
            android:title="@string/pref_btn_map_clear_title"
            android:visible="false" />

    </PreferenceCategory>

</PreferenceScreen>
