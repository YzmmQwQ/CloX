<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <ListPreference
        android:key="double_tap_action"
        android:title="@string/pref_double_tap_title"
        android:summary="%s"
        android:entries="@array/double_tap_entries"
        android:entryValues="@array/double_tap_values"
        android:defaultValue="settings" />

    <ListPreference
        android:key="long_press_action"
        android:title="@string/pref_long_press_title"
        android:summary="%s"
        android:entries="@array/long_press_entries"
        android:entryValues="@array/long_press_values"
        android:defaultValue="none" />


    <SwitchPreferenceCompat
        android:key="home_press_screen_off"
        android:title="@string/pref_home_press_screen_off_title"
        android:summary="@string/pref_home_press_screen_off_summary"
        android:defaultValue="false" />

</PreferenceScreen>
