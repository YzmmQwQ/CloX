<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="General">
        <SwitchPreferenceCompat
            android:key="qs_enabled"
            android:title="@string/qs_enabled_title"
            android:summary="@string/qs_enabled_summary"
            android:defaultValue="true" />

        <SeekBarPreference
            android:key="qs_sensitivity"
            android:title="@string/qs_sensitivity_title"
            android:min="20"
            android:max="200"
            android:defaultValue="60" />

        <ListPreference
            android:key="qs_tile_rows"
            android:title="@string/qs_tile_rows_title"
            android:summary="%s"
            android:entries="@array/tile_rows_entries"
            android:entryValues="@array/tile_rows_values"
            android:defaultValue="2" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Tiles">
        <Preference
            android:key="qs_tile_editor"
            android:title="@string/qs_tile_editor_title"
            android:summary="@string/qs_tile_editor_summary"
            android:fragment="com.ailife.clox.settings.fragments.TileEditorFragment" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Flashlight">
        <SwitchPreferenceCompat
            android:key="qs_flashlight_hardware"
            android:title="@string/qs_flashlight_hw_title"
            android:summary="@string/qs_flashlight_hw_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Appearance">

        <ListPreference
            android:key="qs_tile_style"
            android:title="Tile style"
            android:summary="%s"
            android:entries="@array/qs_tile_style_entries"
            android:entryValues="@array/qs_tile_style_values"
            android:defaultValue="stroke" />

        <SwitchPreferenceCompat
            android:key="qs_color_tiles"
            android:title="@string/qs_color_tiles_title"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="qs_use_system_color"
            android:title="@string/qs_system_color_title"
            android:summary="@string/qs_system_color_summary"
            android:defaultValue="false" />
        <Preference android:key="qs_color_connected" android:title="@string/qs_color_connected_title" android:summary="#379950" />
        <Preference android:key="qs_color_idle" android:title="@string/qs_color_idle_title" android:summary="#2444E3" />
        <Preference android:key="qs_color_disconnected" android:title="@string/qs_color_disconnected_title" android:summary="#AD7623" />
        <Preference android:key="qs_color_off" android:title="@string/qs_color_off_title" android:summary="#AAAAAA" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Elevated Privileges">
        <ListPreference
            android:key="qs_privilege"
            android:title="@string/qs_privilege_title"
            android:summary="%s"
            android:entries="@array/privilege_entries"
            android:entryValues="@array/privilege_values"
            android:defaultValue="none" />
        <Preference
            android:key="qs_privilege_status"
            android:title="@string/qs_privilege_status_title"
            android:enabled="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Accessibility">
        <Preference
            android:key="qs_accessibility_status"
            android:title="@string/qs_accessibility_status_title"
            android:summary="@string/qs_accessibility_status_summary" />
    </PreferenceCategory>

</PreferenceScreen>
