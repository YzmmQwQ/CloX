<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/pref_location_category_primary">

        <EditTextPreference
            android:key="location_name_1"
            android:title="@string/pref_location_city_title"
            android:summary="@string/pref_location_city_summary"
            android:defaultValue="" />

        <EditTextPreference
            android:key="location_lat"
            android:title="@string/pref_location_lat_title"
            android:summary="@string/pref_location_lat_summary"
            android:defaultValue="" />

        <EditTextPreference
            android:key="location_lon"
            android:title="@string/pref_location_lon_title"
            android:summary="@string/pref_location_lon_summary"
            android:defaultValue="" />

        <Preference
            android:key="location_get_gps"
            android:title="@string/pref_location_gps_title"
            android:summary="@string/pref_location_gps_summary" />

        <SwitchPreferenceCompat
            android:key="location_auto_update"
            android:title="@string/pref_location_auto_title"
            android:summary="@string/pref_location_auto_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_location_category_extra">

        <EditTextPreference
            android:key="location_name_2"
            android:title="@string/pref_location_slot2_city"
            android:defaultValue="" />

        <ListPreference
            android:key="location_timezone_1"
            android:title="@string/pref_location_slot2_tz"
            android:summary="%s"
            android:entries="@array/timezone_offset_entries"
            android:entryValues="@array/timezone_offset_values"
            android:defaultValue="0" />

        <EditTextPreference
            android:key="location_name_3"
            android:title="@string/pref_location_slot3_city"
            android:defaultValue="" />

        <ListPreference
            android:key="location_timezone_2"
            android:title="@string/pref_location_slot3_tz"
            android:summary="%s"
            android:entries="@array/timezone_offset_entries"
            android:entryValues="@array/timezone_offset_values"
            android:defaultValue="0" />

        <EditTextPreference
            android:key="location_name_4"
            android:title="@string/pref_location_slot4_city"
            android:defaultValue="" />

        <ListPreference
            android:key="location_timezone_3"
            android:title="@string/pref_location_slot4_tz"
            android:summary="%s"
            android:entries="@array/timezone_offset_entries"
            android:entryValues="@array/timezone_offset_values"
            android:defaultValue="0" />

        <EditTextPreference
            android:key="location_name_5"
            android:title="@string/pref_location_slot5_city"
            android:defaultValue="" />

        <ListPreference
            android:key="location_timezone_4"
            android:title="@string/pref_location_slot5_tz"
            android:summary="%s"
            android:entries="@array/timezone_offset_entries"
            android:entryValues="@array/timezone_offset_values"
            android:defaultValue="0" />

    </PreferenceCategory>

</PreferenceScreen>
