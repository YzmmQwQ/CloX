<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreferenceCompat
        android:key="notif_enabled"
        android:title="@string/notif_setting_enabled_title"
        android:summary="@string/notif_setting_enabled_summary"
        android:defaultValue="true" />

    <ListPreference
        android:key="notif_card_style"
        android:title="@string/notif_setting_card_style_title"
        android:summary="%s"
        android:entries="@array/notif_card_style_entries"
        android:entryValues="@array/notif_card_style_values"
        android:defaultValue="glass"
        android:dependency="notif_enabled" />

    <ListPreference
        android:key="notif_style"
        android:title="@string/notif_setting_view_style_title"
        android:summary="%s"
        android:entries="@array/notif_style_entries"
        android:entryValues="@array/notif_style_values"
        android:defaultValue="list"
        android:dependency="notif_enabled" />

    <SeekBarPreference
        android:key="notif_text_size"
        android:title="@string/notif_setting_text_size_title"
        android:min="10"
        android:max="30"
        android:defaultValue="14"
        android:dependency="notif_enabled"
        app:showSeekBarValue="true"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <SwitchPreferenceCompat
        android:key="notif_media_enabled"
        android:title="@string/notif_setting_media_controls_title"
        android:summary="@string/notif_setting_media_controls_summary"
        android:defaultValue="true"
        android:dependency="notif_enabled" />

    <PreferenceCategory
        android:title="@string/notif_setting_alerts_category"
        android:dependency="notif_enabled">

        <SwitchPreferenceCompat
            android:key="notif_wake_screen"
            android:title="@string/notif_setting_wake_title"
            android:summary="@string/notif_setting_wake_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="notif_open_panel"
            android:title="@string/notif_setting_open_panel_title"
            android:summary="@string/notif_setting_open_panel_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="notif_vibrate"
            android:title="@string/notif_setting_vibrate_title"
            android:summary="@string/notif_setting_vibrate_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/notif_setting_filtering_category"
        android:dependency="notif_enabled">

        <SwitchPreferenceCompat
            android:key="notif_group"
            android:title="@string/notif_setting_group_title"
            android:summary="@string/notif_setting_group_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="notif_block_persistent"
            android:title="@string/notif_setting_hide_persistent_title"
            android:summary="@string/notif_setting_hide_persistent_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <Preference
        android:key="notif_permission_status"
        android:title="@string/notif_setting_access_title"
        android:icon="@drawable/ic_notifications"
        android:dependency="notif_enabled" />

</PreferenceScreen>
