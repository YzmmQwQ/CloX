<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- ip-api.com free tier does not support HTTPS -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">ip-api.com</domain>
    </domain-config>
    <!--
        HTTP for the embedded LAN remote-management server is enabled via
        android:usesCleartextTraffic="true" on the application element in the
        manifest. Network security config cannot match arbitrary IP addresses,
        so the manifest attribute is the correct mechanism here.
    -->
</network-security-config>
