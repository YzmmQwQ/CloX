<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="nav_wf_open_selector"
        android:title="@string/pref_wf_open_selector_title"
        android:summary="@string/pref_wf_open_selector_summary"
        android:icon="@drawable/ic_watchface_placeholder" />

    <PreferenceCategory android:title="@string/pref_wf_category_selector">

        <ListPreference
            android:key="watchface_selector_mode"
            android:title="@string/pref_wf_selector_mode_title"
            android:summary="%s"
            android:entries="@array/wf_selector_mode_entries"
            android:entryValues="@array/wf_selector_mode_values"
            android:defaultValue="pager" />

        <ListPreference
            android:key="watchface_sort_order"
            android:title="@string/pref_wf_sort_title"
            android:summary="%s"
            android:entries="@array/wf_sort_entries"
            android:entryValues="@array/wf_sort_values"
            android:defaultValue="name" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_wf_category_auto">

        <SwitchPreferenceCompat
            android:key="wf_auto_change_on_screen_on"
            android:title="@string/pref_wf_auto_screen_on_title"
            android:summary="@string/pref_wf_auto_screen_on_summary"
            android:defaultValue="false" />

        <ListPreference
            android:key="wf_auto_change_interval"
            android:title="@string/pref_wf_auto_interval_title"
            android:summary="%s"
            android:entries="@array/wf_auto_interval_entries"
            android:entryValues="@array/wf_auto_interval_values"
            android:defaultValue="none" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_wf_category_management">

        <Preference
            android:key="nav_wf_store"
            android:title="@string/pref_wf_store_title"
            android:summary="@string/pref_wf_store_summary" />

        <Preference
            android:key="nav_wf_remote"
            android:title="@string/pref_wf_remote_title"
            android:summary="@string/pref_wf_remote_summary" />

        <Preference
            android:key="nav_wf_import"
            android:title="@string/pref_wf_import_title"
            android:summary="@string/pref_wf_import_summary" />

        <Preference
            android:key="nav_wf_gallery"
            android:title="@string/pref_wf_gallery_title"
            android:summary="@string/pref_wf_gallery_summary" />

    </PreferenceCategory>

</PreferenceScreen>
