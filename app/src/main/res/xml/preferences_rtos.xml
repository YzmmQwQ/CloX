<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreferenceCompat
        android:key="rtos_enabled"
        android:title="@string/rtos_setting_enabled_title"
        android:summary="@string/rtos_setting_enabled_summary"
        android:defaultValue="false" />

    <ListPreference
        android:key="rtos_mode"
        android:title="@string/rtos_setting_mode_title"
        android:summary="%s"
        android:entries="@array/rtos_mode_entries"
        android:entryValues="@array/rtos_mode_values"
        android:defaultValue="watchface_only"
        android:dependency="rtos_enabled" />

    <Preference
        android:key="rtos_nav_password"
        android:title="@string/rtos_setting_set_password_title"
        android:summary="@string/rtos_setting_set_password_summary" />

    <ListPreference
        android:key="rtos_password_type"
        android:title="@string/rtos_setting_password_type_title"
        android:summary="%s"
        android:entries="@array/rtos_password_entries"
        android:entryValues="@array/rtos_password_values"
        android:defaultValue="keypad" />

    <SwitchPreferenceCompat
        android:key="rtos_auto_enter"
        android:title="@string/rtos_setting_auto_enter_title"
        android:summary="@string/rtos_setting_auto_enter_summary"
        android:defaultValue="false" />

    <SwitchPreferenceCompat
        android:key="rtos_launcher_icon"
        android:title="@string/rtos_setting_show_icon_title"
        android:summary="@string/rtos_setting_launcher_icon_summary"
        android:defaultValue="false" />

    <Preference
        android:key="rtos_nav_whitelist"
        android:title="@string/rtos_setting_allowed_apps_title"
        android:summary="@string/rtos_setting_allowed_apps_summary"
        android:dependency="rtos_enabled" />

    <Preference
        android:key="rtos_accessibility"
        android:title="@string/rtos_setting_accessibility_title"
        android:summary="@string/rtos_accessibility_disabled" />

    <SwitchPreferenceCompat
        android:key="rtos_block_apps"
        android:title="@string/rtos_setting_block_apps_title"
        android:summary="@string/rtos_setting_block_apps_summary"
        android:defaultValue="false" />

</PreferenceScreen>
