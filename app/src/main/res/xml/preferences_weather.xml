<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SwitchPreferenceCompat
        android:key="weather_enabled"
        android:title="@string/pref_weather_enabled_title"
        android:summary="@string/pref_weather_enabled_summary"
        android:defaultValue="false" />

    <PreferenceCategory android:title="@string/pref_weather_category_source">

        <ListPreference
            android:key="weather_provider"
            android:title="@string/pref_weather_provider_title"
            android:summary="%s"
            android:entries="@array/weather_provider_entries"
            android:entryValues="@array/weather_provider_values"
            android:defaultValue="metno" />

        <SwitchPreferenceCompat
            android:key="weather_auto_language"
            android:title="@string/pref_weather_language_title"
            android:summary="@string/pref_weather_language_summary"
            android:defaultValue="true" />

        <EditTextPreference
            android:key="weather_weatherapi_key"
            android:title="@string/pref_weather_weatherapi_key_title"
            android:summary="@string/pref_weather_weatherapi_key_summary"
            android:defaultValue="" />

        <EditTextPreference
            android:key="weather_owm_key"
            android:title="@string/pref_weather_owm_key_title"
            android:summary="@string/pref_weather_owm_key_summary"
            android:defaultValue="" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_weather_category_display">

        <SwitchPreferenceCompat
            android:key="weather_round_temp"
            android:title="@string/pref_weather_round_title"
            android:summary="@string/pref_weather_round_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_weather_category_update">

        <ListPreference
            android:key="weather_interval_minutes"
            android:title="@string/pref_weather_interval_title"
            android:summary="%s"
            android:entries="@array/weather_interval_entries"
            android:entryValues="@array/weather_interval_values"
            android:defaultValue="30" />

        <Preference
            android:key="weather_refresh_now"
            android:title="@string/pref_weather_refresh_title"
            android:summary="@string/pref_weather_refresh_summary" />

    </PreferenceCategory>

</PreferenceScreen>
