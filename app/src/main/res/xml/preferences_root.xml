<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="nav_notifications"
        android:title="Notifications"
        android:summary="Panel style, alerts, filtering, blocked apps"
        android:icon="@drawable/ic_notifications"
        android:fragment="com.ailife.clox.settings.fragments.NotificationSettingsFragment" />

    <Preference
        android:key="nav_quick_settings"
        android:title="@string/qs_title"
        android:summary="Tiles, columns, gestures, flashlight, colors, privileges"
        android:fragment="com.ailife.clox.settings.fragments.QuickSettingsSettingsFragment" />

    <Preference
        android:key="nav_app_list"
        android:title="App list"
        android:summary="Style, sort order, icon pack"
        android:fragment="com.ailife.clox.settings.fragments.AppListSettingsFragment" />

    <Preference
        android:key="nav_watchface"
        android:title="@string/pref_watchface_title"
        android:summary="@string/pref_watchface_summary"
        android:fragment="com.ailife.clox.settings.fragments.WatchfaceSettingsFragment" />

    <Preference
        android:key="nav_gestures"
        android:title="Gestures"
        android:summary="Double-tap, long-press, hardware button mapping"
        android:fragment="com.ailife.clox.settings.fragments.GesturesSettingsFragment" />

    <Preference
        android:key="nav_aod"
        android:title="@string/pref_aod_title"
        android:summary="@string/pref_aod_summary"
        android:icon="@drawable/ic_aod"
        android:fragment="com.ailife.clox.settings.fragments.AodSettingsFragment" />

    <Preference
        android:key="nav_appearance"
        android:title="Appearance"
        android:summary="Blur mode and radius"
        android:fragment="com.ailife.clox.settings.fragments.AppearanceSettingsFragment" />

    <Preference
        android:key="nav_tap_actions"
        android:title="@string/pref_tap_title"
        android:summary="@string/pref_tap_summary"
        android:fragment="com.ailife.clox.settings.fragments.TapActionsSettingsFragment" />

    <Preference
        android:key="nav_weather"
        android:title="@string/pref_weather_title"
        android:summary="@string/pref_weather_summary"
        android:fragment="com.ailife.clox.settings.fragments.WeatherSettingsFragment" />

    <Preference
        android:key="nav_location"
        android:title="@string/pref_location_title"
        android:summary="@string/pref_location_summary"
        android:fragment="com.ailife.clox.settings.fragments.LocationSettingsFragment" />

    <Preference
        android:key="nav_health"
        android:title="@string/pref_health_title"
        android:summary="@string/pref_health_summary"
        android:fragment="com.ailife.clox.settings.fragments.HealthSettingsFragment" />

    <Preference
        android:key="nav_sensors"
        android:title="@string/pref_sensors_title"
        android:summary="@string/pref_sensors_summary"
        android:fragment="com.ailife.clox.settings.fragments.SensorsSettingsFragment" />

    <Preference
        android:key="nav_hide_apps"
        android:title="Hidden apps"
        android:summary="Blacklist or whitelist apps from the launcher" />

    <Preference
        android:key="nav_rtos"
        android:title="RTOS Mode"
        android:summary="Disguise launcher as a Bluetooth RTOS watch"
        android:fragment="com.ailife.clox.rtos.settings.RtosSettingsFragment" />

</PreferenceScreen>
