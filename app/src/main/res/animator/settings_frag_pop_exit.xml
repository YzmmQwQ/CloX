<?xml version="1.0" encoding="utf-8"?>
<!-- Seeked frame-by-frame during the predictive back gesture drag. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep the leaving (top-of-stack) fragment elevated above the re-entering one so it
         slides out on top instead of being drawn behind it. -->
    <objectAnimator
        android:duration="300"
        android:propertyName="translationZ"
        android:valueFrom="8dp"
        android:valueTo="8dp" />
    <objectAnimator
        android:duration="300"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:propertyName="translationX"
        android:valueFrom="0dp"
        android:valueTo="120dp" />
    <objectAnimator
        android:duration="300"
        android:propertyName="alpha"
        android:valueFrom="1"
        android:valueTo="0" />
</set>
